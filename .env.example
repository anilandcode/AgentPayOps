# AI finance memos run on Command Code (see src/lib/cmd-llm.ts).
# Local dev: install the `cmd` CLI and log in once — no key needed here (Go plan OK).
# Deployments: CMD_API_KEY enables the Provider API transport (needs a plan with
# API access: GOAT/Pro/Max/Provider). The app auto-falls back to deterministic
# memos when neither transport can answer, so the demo never breaks.
CMD_LLM_MODE=auto
CMD_BIN=
CMD_API_KEY=
CMD_MO…lpha,xiaomi/mimo-v2.6-pro,meta/muse-spark-1.3-contributor
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional aliases and future persistence config.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# X402 payment mode.
# Demo keeps the browser workflow usable without a wallet.
X402_MODE=demo
X402_RECEIVING_ADDRESS=
EVM_ADDRESS=
X402_NETWORK=eip155:84532
X402_VENDOR_REPORT_PRICE=0.42
X402_FACILITATOR_URL=https://facilitator.x402.org
